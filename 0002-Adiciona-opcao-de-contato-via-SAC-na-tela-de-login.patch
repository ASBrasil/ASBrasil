From 89c4d826cc03451bb93448bb9b2d4b1596a08df4 Mon Sep 17 00:00:00 2001
From: Paulo Emanuel <pauloemanuel96@gmail.com>
Date: Fri, 14 Aug 2026 23:56:17 +0000
Subject: [PATCH 2/2] Adiciona opcao de contato via SAC na tela de login

Abaixo do botao Continuar, mostra 'Nao conseguiu acessar? Fale com
nosso time via SAC em horario comercial', com link direto pro
telefone (0800 880 117) e WhatsApp.
---
 components/EntrarForm.tsx | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/components/EntrarForm.tsx b/components/EntrarForm.tsx
index fc59daf..81604bd 100644
--- a/components/EntrarForm.tsx
+++ b/components/EntrarForm.tsx
@@ -51,6 +51,18 @@ export function EntrarForm() {
         {loading ? "Verificando…" : "Continuar →"}
       </button>
 
+      <div className="support">
+        <p>Não conseguiu acessar?</p>
+        <p>
+          Fale com nosso time via SAC em horário comercial:{" "}
+          <a href="tel:08008801117">0800 880 117</a> ou{" "}
+          <a href="https://wa.me/558008801117" target="_blank" rel="noopener noreferrer">
+            WhatsApp
+          </a>
+          .
+        </p>
+      </div>
+
       <style jsx>{`
         .form {
           width: 22rem;
@@ -105,6 +117,30 @@ export function EntrarForm() {
           opacity: 0.6;
           cursor: default;
         }
+        .support {
+          margin-top: 1.75rem;
+          padding-top: 1.25rem;
+          border-top: 1px solid #e6e8f0;
+        }
+        .support p {
+          margin: 0;
+          font-size: 0.8rem;
+          color: #6b7280;
+          line-height: 1.5;
+        }
+        .support p:first-child {
+          font-weight: 600;
+          color: #374151;
+          margin-bottom: 0.2rem;
+        }
+        .support a {
+          color: #4f5fff;
+          font-weight: 600;
+          text-decoration: none;
+        }
+        .support a:hover {
+          text-decoration: underline;
+        }
       `}</style>
     </form>
   );
