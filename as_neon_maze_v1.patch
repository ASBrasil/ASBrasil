+  foeSpawns: [number, number][];
+  dotCount: number;
+  // Intervalo (ms) entre passos dos fantasmas normais / do fantasma-chefe
+  // (mais rápido, só aparece depois de coletar todos os pontinhos).
+  ghostMoveMs: number;
+  bossMoveMs: number;
+  minClearMs: number;
+  starTimeMs: number;
+}
