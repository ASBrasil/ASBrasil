# Postgres connection string (use a managed instance in production:
# Neon, RDS, Supabase, etc). SQLite works for local dev if you switch the
# provider in prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/sorteios"

# Long random string used to sign admin session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# S3-compatible bucket for prize images, banners, logos, winner photos.
STORAGE_BUCKET="sorteios-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
