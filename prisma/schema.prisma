// Reference schema. Use Postgres in production (set provider = "postgresql"
// and DATABASE_URL to a managed instance). SQLite is fine for local dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ParticipantSource {
  IMPORT
  SIGNUP
  MANUAL
  MISSION
}

enum ParticipantModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WinnerPolicy {
  KEEP      // winner keeps competing in later draws of the same event
  REMOVE    // winner is excluded from later draws of the same event
}

enum PrizeStatus {
  PENDING
  DRAWN
  VOIDED // a draw was invalidated and redone; kept for audit, never deleted
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | OPERATOR (extend as needed)
  createdAt    DateTime @default(now())
}

model Event {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  campaign             String?
  description          String?
  startAt              DateTime?
  endAt                DateTime?
  active               Boolean  @default(true)
  // Soft delete: hides the event from the default admin list without
  // touching participants/prizes/results. Excluir (DELETE) is the hard,
  // irreversible version.
  archived             Boolean  @default(false)

  // Theme is a JSON blob edited through the visual theme editor.
  // { colors: {...}, fonts: {...}, bannerUrl, logoUrl, customCss }
  theme                Json     @default("{}")

  publicSignupEnabled  Boolean  @default(false)
  // Which fields the public signup form asks for + which are required.
  // [{ key: "name", label: "Nome", required: true }, ...]
  signupFields         Json     @default("[]")
  // When true, public signups start as PENDING (still get a raffle number
  // right away, so the participant sees something immediately, but they're
  // excluded from actual draws until an admin approves them - e.g. after
  // reviewing a photo comprovante). When false (default), signups are
  // auto-approved, same behavior as before this existed.
  requireSignupApproval Boolean @default(false)

  // Blocos de conteúdo editáveis da Landing Page pública - array de
  // { id, type: "text" | "image" | "cards", order, ...campos por tipo }.
  // Renderizados entre o hero e a lista de prêmios em /e/[slug]. Vazio por
  // padrão - eventos sem nada configurado aqui simplesmente não mostram
  // nada extra (comportamento igual ao de antes dessa funcionalidade).
  lpBlocks             Json     @default("[]")

  winnerPolicy         WinnerPolicy @default(KEEP)

  // Manual ordering for the admin listing (and anywhere else events are
  // shown side by side). Scoped independently for active vs archived -
  // moving an event only ever compares against others in the same tab.
  order                Int      @default(0)

  // Shown in the rotating banner on /entrar (the participant login page).
  // Admin-curated on purpose, not automatic from `active` - not every
  // running event necessarily wants to be advertised there.
  featuredOnLogin      Boolean  @default(false)
  // Free-text override for what the banner actually says. Falls back to
  // "{campaign} — {name}" when empty, so turning featuredOnLogin on works
  // immediately without forcing the admin to write custom copy first.
  loginBannerText      String?

  // "Global": discoverable by ANY participant known to the system (any
  // email that has ever been imported/signed up anywhere), not just people
  // with a ticket in this specific event - shown as a "Mais sorteios" card
  // in /meus-eventos. Independent of `featuredOnLogin`, which is about the
  // pre-login banner instead.
  global               Boolean  @default(false)
  // Premium visual treatment (diamond badge) within the global discovery
  // list - only meaningful when `global` is also true.
  vip                  Boolean  @default(false)
  // Free text shown to someone who clicks into a global event they don't
  // have a ticket for yet, explaining what they need to do to join
  // (e.g. "Compre o produto X para participar"). Optional even on global
  // events - if empty, the prerequisite screen just won't show a specific ask.
  prerequisiteText     String?

  // Rotating hero banner at the top of /meus-eventos (the participant's
  // event list) - independent of `vip`/`global`, full manual control, so
  // the admin can spotlight whichever raffle makes sense for that
  // prominent "wow factor" slot. Reuses theme.bannerUrl for the image
  // itself - no separate upload needed.
  heroFeatured         Boolean  @default(false)

  // "Simples" (padrão): a pessoa participa direto, sem barreira nenhuma.
  // "Com missões": precisa completar as missões obrigatórias abaixo antes
  // de ver seus números/resultados naquele evento.
  missionMode          EventMissionMode @default(SIMPLE)
  missions             Mission[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  participants         Participant[]
  prizes                Prize[]
  imports               ImportBatch[]
  presences            Presence[]
  participantNotices   ParticipantNotice[]

  @@index([active])
  @@index([archived])
  @@index([archived, order])
}

// Presença "ao vivo": o painel do participante manda um ping periódico
// enquanto a aba está aberta (ver PresenceHeartbeat), então essa tabela só
// guarda o último ping por pessoa+evento - não é histórico, é sempre
// sobrescrita (upsert). "Online agora" no dashboard do admin = contar quem
// tem lastSeenAt nos últimos ~90s. Diferente do LoginEvent (que só marca
// UMA visita, no carregamento da página) - essa aqui reflete presença
// contínua enquanto a pessoa está de fato com a tela aberta.
model Presence {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email      String
  lastSeenAt DateTime @default(now())

  @@unique([eventId, email])
  @@index([eventId, lastSeenAt])
}

// Aviso pontual que o admin dispara pra uma pessoa específica (ex: "você
// ainda não completou tal missão") a partir do painel de pendências de
// pré-requisito - vira um pop-up na próxima vez que ela abrir o painel do
// evento. Não existe envio de e-mail/push aqui: é só um recado que fica
// esperando na conta dela até ser visto (readAt), já que o sistema não
// dispara notificação fora do próprio site.
model ParticipantNotice {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email     String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([eventId, email, readAt])
}

model Participant {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Qual missão gerou/revelou esse número, quando aplicável (fica null pra
  // inscrição normal, import ou cadastro manual). Só serve pra fila de
  // Aprovações saber de qual missão veio o comprovante que ela está
  // mostrando - onDelete SetNull porque apagar a missão depois não deveria
  // apagar o ticket que ela já gerou.
  missionId     String?
  mission       Mission?          @relation(fields: [missionId], references: [id], onDelete: SetNull)

  name          String
  email         String
  phone         String?
  cpf           String?
  orderNumber   String?

  // Per-ticket external identifier from the source spreadsheet (e.g. a
  // ticketing platform's "ticket code"), when the import mapped one. Lets a
  // re-import of the same file skip rows it already created instead of
  // relying on email uniqueness - which we deliberately do NOT enforce here,
  // since one buyer's e-mail legitimately covers several distinct people /
  // tickets (each with their own raffle number and their own shot at
  // winning). Nullable + unique: Postgres treats every NULL as distinct, so
  // participants without a ticket code (e.g. public signups) never collide
  // with each other on this column.
  ticketCode    String?

  // Unique, permanent number used across every draw in the event.
  raffleNumber  Int

  source        ParticipantSource @default(IMPORT)
  importBatchId String?
  removedFromDraws Boolean        @default(false) // set when they win under REMOVE policy

  // Inscrição pública com campos extras: comprovante/foto enviado junto
  // (ex: print de um comentário no Instagram) ganha sua própria coluna, já
  // que é um caso de uso comum o suficiente pra merecer; qualquer OUTRO
  // campo customizado que o admin tenha configurado (ex: "@ do Instagram")
  // fica guardado aqui como JSON livre, sem precisar de migration nova
  // toda vez que um evento pedir um campo diferente.
  photoUrl      String?
  customData    Json?

  // Default APPROVED so every existing participant (imports, manual adds,
  // signups on events that never turned on moderation) is unaffected.
  // Only events with Event.requireSignupApproval=true ever create someone
  // as PENDING - performDraw() excludes non-APPROVED participants from
  // eligibility, so a still-pending or rejected signup simply can't win
  // until/unless an admin approves them.
  moderationStatus ParticipantModerationStatus @default(APPROVED)

  // True só pro "ticket base" de um evento que usa missões de escolha
  // (grantsExtraTicket) como pré-requisito pro PRIMEIRO número - criado
  // silenciosamente no cadastro, mas escondido da pessoa até ela escolher
  // e completar alguma dessas missões. Vira false (revelado) na primeira
  // que ela completar. Sempre false pra eventos que não usam esse modelo.
  awaitingPrerequisite Boolean @default(false)

  // Lookup token lets us avoid ever exposing raffle numbers by guessable id;
  // the public lookup endpoint matches on normalized email + event, rate limited.
  createdAt     DateTime          @default(now())

  drawResults   DrawResult[]

  // Intentionally NOT @@unique([eventId, email]) - a single buyer's e-mail
  // can legitimately own several Participant rows in the same event (one
  // per ticket), each with its own raffleNumber and its own draw odds.
  @@unique([eventId, ticketCode])
  @@unique([eventId, raffleNumber])
  @@index([eventId, email])
  @@index([missionId])
}

model Prize {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  imageUrl     String?
  quantity     Int         @default(1)
  order        Int         @default(0)
  status       PrizeStatus @default(PENDING)
  scheduledAt  DateTime?
  rules        String?

  // When true and scheduledAt is set, a Vercel Cron job draws this prize
  // automatically once its time arrives - no admin click needed. Requires
  // scheduledAt to actually mean something; toggling this on without a
  // date set just means "nothing happens automatically" until one is added.
  autoDraw     Boolean     @default(false)

  // "Prêmio surpresa": fica escondido do participante (nome/imagem/
  // descrição) até `unlockAt` passar - só aparece um teaser com contador
  // (ou "data a definir" quando unlockAt é null) e um botão pra ativar
  // aviso por e-mail. Independente de `scheduledAt`/`autoDraw`, que
  // continuam controlando quando o SORTEIO em si acontece - unlockAt é só
  // sobre quando o prêmio deixa de ser segredo. Revelação é sempre
  // derivada (surprise && (unlockAt == null || unlockAt > agora)), nunca
  // um campo separado pra não desincronizar.
  surprise     Boolean     @default(false)
  unlockAt     DateTime?

  // Shown on the participant's result screen for this prize. Falls back to
  // a generic message in the UI when null, so setting these is optional.
  winMessage   String?     // shown only to the winner
  loseMessage  String?     // shown to everyone else once the draw is done
  couponCode   String?     // revealed only to the winner, alongside winMessage

  createdAt    DateTime    @default(now())

  drawResults     DrawResult[]
  losePopup       PrizeLosePopup?
  notifyRequests  PrizeNotifyRequest[]

  @@index([eventId, order])
}

// Quem pediu aviso por e-mail pra saber quando um prêmio surpresa for
// revelado. Não envia nada sozinho - o admin exporta essa lista (CSV) e
// importa/dispara pelo Brevo (ferramenta de e-mail que já usa), então essa
// tabela só existe pra coletar e não perder quem pediu.
model PrizeNotifyRequest {
  id        String   @id @default(cuid())
  prizeId   String
  prize     Prize    @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([prizeId, email])
}

// A pop-up shown to whoever DIDN'T win this specific prize, once the draw
// reveals - separate from the global Popup (which is one site-wide banner
// on /meus-eventos, unrelated to any particular draw). Reuses the exact
// same content shape (type/title/body/imageUrl/linkUrl) so admins already
// familiar with the global pop-up editor feel right at home here. Typical
// use: a consolation offer ("didn't win? upgrade to VIP instead") with a
// link to act on it.
model PrizeLosePopup {
  id        String    @id @default(cuid())
  prizeId   String    @unique
  prize     Prize     @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  active    Boolean   @default(false)
  type      PopupType @default(TEXT)
  title     String?
  body      String?
  imageUrl  String?
  linkUrl   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Append-only. A draw is never edited in place - redoing a draw VOIDs the
// previous result and inserts a new one, so the full history is auditable.
model DrawResult {
  id             String   @id @default(cuid())
  prizeId        String
  prize          Prize    @relation(fields: [prizeId], references: [id])
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id])

  winningNumber  Int
  eligibleCount  Int      // how many participants were in the pool, for audit
  rngSeed        String   // hex seed used, so the draw can be independently verified
  voided         Boolean  @default(false)

  winnerPhotoUrl String?
  publishedAt    DateTime?

  drawnAt        DateTime @default(now())
  drawnByAdminId String?
  drawnAutomatically Boolean @default(false) // true if the cron job triggered this, not an admin click

  @@index([prizeId])
}

model ImportBatch {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  filename      String
  columnMapping Json         // { name: "Nome", email: "E-mail", orderNumber: "Pedido", ... }
  totalRows     Int          @default(0)
  validRows     Int          @default(0)
  errorRows     Int          @default(0)
  errors        Json         @default("[]") // sample of first N errors for the admin to review
  status        ImportStatus @default(PROCESSING)

  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
}

enum PopupType {
  TEXT
  IMAGE
  HTML
}

// A single announcement shown to participants right when they land on
// /meus-eventos - not tied to a specific event, since that page is where
// people go before picking one. Only ever one `active` at a time (enforced
// in the API, not the schema): activating one deactivates the rest, so
// there's never ambiguity about which popup a visitor should see.
model Popup {
  id        String    @id @default(cuid())
  active    Boolean   @default(false)
  type      PopupType @default(TEXT)

  title     String?   // opcional nos 3 tipos - vira o cabecalho do popup
  body      String?   // texto simples (TEXT) ou HTML bruto confiavel (HTML)
  imageUrl  String?   // usado no tipo IMAGE
  linkUrl   String?   // opcional - se preenchido, o popup inteiro vira um link

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

// One row per successful login (a known e-mail entering via /entrar) - an
// append-only log, deliberately not deduplicated by day at write time.
// Powers two things today: total entry count and "active in last 48h"
// (both computed at read time), and is shaped to support a future
// day-streak feature (e.g. "log in 5 days running, spin a wheel") without
// needing a schema change - that just becomes a query grouping these rows
// by calendar day per e-mail.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  // Preenchido quando o acesso é a um evento específico (visita ao
  // painel), null quando é só o login geral em /entrar. Nome guardado
  // "congelado" (não é uma relação) - continua fazendo sentido no
  // histórico mesmo se o evento for arquivado ou excluído depois.
  eventId   String?
  eventName String?

  @@index([email, createdAt])
  @@index([createdAt])
  @@index([eventId, createdAt])
}

enum EventMissionMode {
  SIMPLE
  MISSIONS
}

enum MissionType {
  SELF_CHECK   // autodeclaração - ex: "Siga no Instagram", botão "Já fiz!"
  QUIZ         // pergunta de múltipla escolha, correção automática
  PHOTO_UPLOAD // participante envia uma foto
  LINK_VISIT   // visita um link e confirma
}

model Mission {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type        MissionType
  order       Int         @default(0)
  // Obrigatória bloqueia o acesso aos números/resultados até ser cumprida.
  // Opcional (required: false) fica visível mas não trava nada.
  required    Boolean     @default(true)

  title       String
  description String?

  // SELF_CHECK / LINK_VISIT
  linkUrl     String?

  // QUIZ - opções em texto simples (uma por linha no admin), índice da
  // correta (0-based)
  quizOptions Json?
  quizCorrectIndex Int?

  // Surpresa travada por data: se preenchido, a missão fica TOTALMENTE
  // escondida (nem o titulo/descricao aparecem) ate essa data/hora passar -
  // so um "algo vai ser liberado" generico com contagem regressiva. Sempre
  // opcional na pratica (nunca bloqueia o acesso aos numeros ja
  // conquistados), independente do campo `required` acima.
  unlockAt    DateTime?
  // Quando true, completar essa missao com sucesso cria um novo registro
  // de participante (um numero da sorte A MAIS, adicional, nao substitui
  // nenhum numero anterior) pro mesmo e-mail neste evento, em vez de so
  // marcar a missao como concluida.
  grantsExtraTicket Boolean @default(false)
  // Quando true, o numero gerado por essa missao (seja o primeiro ou um
  // extra) nasce Pendente - so entra de verdade no sorteio depois que o
  // admin aprovar na fila de Aprovacoes. Cada missao decide isso por si -
  // dá pra ter, no mesmo evento, uma missao que aprova na hora e outra
  // que exige revisao manual.
  requiresApproval Boolean @default(false)

  createdAt   DateTime    @default(now())

  completions MissionCompletion[]
  participants Participant[]

  @@index([eventId, order])
}

// Uma pessoa (por e-mail, não por ingresso - a missão vale pra pessoa,
// não pro ticket) só pode completar cada missão uma vez.
model MissionCompletion {
  id          String   @id @default(cuid())
  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  email       String

  photoUrl    String?  // PHOTO_UPLOAD
  quizAnswer  Int?     // QUIZ - índice escolhido
  quizCorrect Boolean? // QUIZ - se acertou

  // Só é a fonte da verdade quando a missão NÃO gera número extra
  // (grantsExtraTicket false) - nesse caso não existe nenhum Participant/
  // ticket criado pra essa conclusão, então sem esse campo uma missão
  // obrigatória com "Exigir aprovação" (ex: comprovante de uma
  // experiência) completava na hora, sem revisão nenhuma, e nunca
  // aparecia em Aprovações. Missões que geram ticket continuam usando
  // Participant.moderationStatus como fonte da verdade - esse campo fica
  // sempre APPROVED nesse caso (não é olhado pra elas).
  moderationStatus ParticipantModerationStatus @default(APPROVED)

  completedAt DateTime @default(now())

  @@unique([missionId, email])
  @@index([missionId])
}
